<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android requires INTERNET for any network connection at all, including a
      connection to a device in the same room, so Soor cannot scan a home
      network without it. What keeps Soor inside the home is not the absence of
      this permission but LocalOnly: every socket the app opens is checked first
      and refused unless the address is a private home-network address.
      LocalOnlyTest proves the rule and fails the build if any connection skips it.

      ACCESS_NETWORK_STATE lets Soor see which network the phone is on, so it
      scans only Wi-Fi or ethernet and never over mobile data.

      When the app moves to target Android 17 (API 37), local network access
      will also need the ACCESS_LOCAL_NETWORK runtime permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Soor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Soor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
